{
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && next dev",
    "build": "bun run typegen && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "bun run db:migrate:production && bun run build && opennextjs-cloudflare deploy",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "typegen": "wrangler types --env-interface CloudflareEnv",
    "typecheck": "bun run typegen && tsc --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/lib/db/seed.ts",
    "db:seed:sql": "bun src/lib/db/seed-sql.ts",
    "admin:create": "bun src/lib/db/create-admin.ts",
    "covers:fetch": "bun scripts/fetch-covers.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.1.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
