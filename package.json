{
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "shx rm -rf .next node_modules bun.lock",
    "db:sync": "bun --env-file .env.local src/lib/db/sync.ts",
    "dev": "bun db:sync && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bun run typegen && oxlint .",
    "format": "oxfmt .",
    "typegen": "wrangler types --env-interface CloudflareEnv",
    "pages:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
