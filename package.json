    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.38.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
