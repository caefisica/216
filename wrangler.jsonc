{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "216",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "216",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "216",
      "database_id": "5e1a9f58-f85e-4c91-8ffa-ec9580ad10e1",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Sender address on a domain onboarded to Cloudflare Email Service. Empty until one exists.
    "MAIL_FROM": "",
  },
  "r2_buckets": [
    {
      "bucket_name": "216-storage",
      "binding": "_216_storage",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
