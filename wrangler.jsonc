{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "216",
  "account_id": "165a663123262d8ba6c08e92cff7e056",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "216",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "216",
      "database_id": "cde257f7-66c1-4d77-bdeb-24ff57bd1687",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Resend's test sender delivers only to the Resend account owner.
    "MAIL_FROM": "onboarding@resend.dev",
  },
  "secrets": {
    "required": ["RESEND_API_KEY"],
  },
  "r2_buckets": [
    {
      "bucket_name": "216-storage",
      "binding": "_216_storage",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
